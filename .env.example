# TataDana Environment Variables Configuration
# Salin file ini ke .env untuk menjalankan di lingkungan lokal / server

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# WEBHOOK BASE URL (WAJIB untuk Telegram Webhook saat di deploy, contoh: https://api.tatadana.id)
WEBHOOK_BASE_URL=http://localhost:3000

# SUPABASE CONFIGURATION (PostgreSQL + Auth + Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_STORAGE_BUCKET=tatadana_exports

# TELEGRAM BOT (Single shared bot token default)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI PROVIDERS (Multi-provider, juga dapat dikonfigurasi & dienkripsi via Admin Dashboard)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# PAYMENT GATEWAY (MIDTRANS)
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_IS_PRODUCTION=false

# SECURITY & AUTH
JWT_SECRET=tatadana_super_secret_jwt_key_2026_finance_shield
ADMIN_SECRET_KEY=admin_master_access_key_9988

# TIMEZONE (WIB - Asia/Jakarta)
TZ=Asia/Jakarta
